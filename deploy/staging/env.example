# The beta (staging) environment's settings and secrets. Copy to .env next to compose.yaml, fill in every value,
# and keep it on the server only (it holds the beta bot's token):  cp env.example .env && chmod 600 .env
# Step by step: docs/setup-guide.md, "Running the beta (staging) environment".

# --- Media folders: beta only ---------------------------------------------------------------------------------------
# Two NEW, empty folders next to your production ones, named so they end in -beta. Create a .requestarr-beta file in
# each (touch tv-beta/.requestarr-beta) to confirm it is for beta only: the stack won't start otherwise. Add both to
# your existing Plex TV and Movies libraries. Never your production TV or movie folders.
BETA_TV_FOLDER=
BETA_MOVIES_FOLDER=

# --- Downloads ------------------------------------------------------------------------------------------------------
# Your download client's downloads folder on this server, and the path your production Sonarr and Radarr see it at
# (so imports work the same way). Only the downloads folder: never a folder that also holds your media.
BETA_DOWNLOADS_FOLDER=
BETA_DOWNLOADS_PATH=/downloads

# --- Ports on this server -------------------------------------------------------------------------------------------
# Three free ports, different from your production Sonarr and Radarr.
BETA_REQUESTARR_PORT=
BETA_SONARR_PORT=
BETA_RADARR_PORT=

# --- File ownership -------------------------------------------------------------------------------------------------
# The user and group your production Sonarr and Radarr run as (so Plex can read what beta downloads), and time zone.
PUID=
PGID=
TZ=Etc/UTC

# --- Beta Sonarr and Radarr API keys --------------------------------------------------------------------------------
# Made up here, 32 letters and digits each (openssl rand -hex 16). Sonarr and Radarr take them on first start.
BETA_SONARR_API_KEY=
BETA_RADARR_API_KEY=
# The quality profile Requestarr asks for (a fresh Sonarr and Radarr have HD-1080p).
BETA_QUALITY_PROFILE=HD-1080p

# --- Requestarr's web portal ----------------------------------------------------------------------------------------
REQUESTARR_ADMIN_USERNAME=
REQUESTARR_ADMIN_PASSWORD=
# Made up here too (openssl rand -hex 16).
REQUESTARR_API_KEY=

# --- The Requestarr Beta Discord bot and server ---------------------------------------------------------------------
# From the Discord Developer Portal (the beta bot's application) and the Requestarr Beta server's ID.
BETA_DISCORD_BOT_TOKEN=
BETA_DISCORD_APPLICATION_ID=
BETA_DISCORD_GUILD_ID=
# Optional: an existing role whose members are Requestarr admins (otherwise Requestarr makes "Requestarr Admin").
BETA_DISCORD_ADMIN_ROLE_ID=

# --- The Movie Database (optional: cast and details on request cards) -----------------------------------------------
TMDB_API_KEY=

# --- Version --------------------------------------------------------------------------------------------------------
# Leave unset to run the newest staging image. ./update.sh rollback sets it to the version before the last update;
# ./update.sh clears it again.
# REQUESTARR_TAG=
