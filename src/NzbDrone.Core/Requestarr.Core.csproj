<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.14" />
    <PackageReference Include="NLog.Targets.Syslog" Version="7.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.5" />
    <PackageReference Include="Polly" Version="8.8.1" />
    <PackageReference Include="FluentMigrator.Runner.Core" Version="6.2.0" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="6.2.0" />
    <PackageReference Include="FluentMigrator.Runner.SQLite" Version="6.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="FluentValidation" Version="9.5.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="5.5.1" />
    <PackageReference Include="Diacritical.Net" Version="1.0.5" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.2" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="AngleSharp" Version="1.8.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NzbDrone.Common\Requestarr.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- What's new on upgrade (Requestarr.Core.Announcements.Changelog). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Requestarr.CHANGELOG.md" />
    <!-- What QA tests before staging (Requestarr.Core.Qa.QaChecklist). -->
    <EmbeddedResource Include="..\..\QA-CHECKLIST.md" LogicalName="Requestarr.QA-CHECKLIST.md" />
    <!-- Images that travel with Discord messages as attachments (Requestarr.Core.Discord.DiscordAssets). -->
    <EmbeddedResource Include="Requestarr\Discord\Assets\*.png" LogicalName="Requestarr.Assets.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Localization\Core\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
