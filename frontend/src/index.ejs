<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Chrome, Safari, Opera, and Firefox OS -->
    <meta name="theme-color" content="#1bb3a6" />
    <!-- Windows Phone -->
    <meta name="msapplication-navbutton-color" content="#464b51" />
    <!-- Android/Apple Phone -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no">

    <meta name="description" content="Requestarr" />

    <!--
      Icons: the environment's set (__ICON_SET__ is filled in by the server: production, dev, qa or beta) in the
      theme the app shows; the script below swaps light and dark.
    -->
    <link
      data-themed
      rel="apple-touch-icon"
      sizes="180x180"
      href="/Content/Images/Icons/__ICON_THEME__/__ICON_SET__/apple-touch-icon.png"
    />
    <link
      data-themed
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/Content/Images/Icons/__ICON_THEME__/__ICON_SET__/favicon-32x32.png"
    />
    <link
      data-themed
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/Content/Images/Icons/__ICON_THEME__/__ICON_SET__/favicon-16x16.png"
    />
    <link data-themed rel="manifest" href="/Content/manifest-__ICON_THEME__.json" crossorigin="use-credentials" />
    <link
      rel="mask-icon"
      href="/Content/Images/Icons/safari-pinned-tab.svg"
      color="#1bb3a6"
    />
    <link
      data-themed
      rel="shortcut icon"
      type="image/ico"
      href="/Content/Images/Icons/__ICON_THEME__/__ICON_SET__/favicon.ico"
    />
    <meta
      data-themed
      name="msapplication-config"
      content="__URL_BASE__/Content/browserconfig-__ICON_THEME__.xml"
    />

    <link rel="stylesheet" type="text/css" href="/Content/Fonts/fonts.css">

    <script>
      window.Requestarr = {
        urlBase: '__URL_BASE__',
        iconSet: '__ICON_SET__'
      };

      // The icons and logo follow the theme the app shows; Auto follows the system setting, also while the page is open.
      // A browser takes the home screen icon, install manifest and Windows tile from whatever is set when it's added.
      (function () {
        var system = window.matchMedia('(prefers-color-scheme: dark)');
        var chosen = '__UI_THEME__';

        function apply() {
          var shade = chosen === 'dark' || (chosen === 'auto' && system.matches) ? 'dark' : 'light';

          document.querySelectorAll('[data-themed]').forEach(function (element) {
            var attribute = element.hasAttribute('src') ? 'src' : element.hasAttribute('href') ? 'href' : 'content';
            var value = element.getAttribute(attribute);

            element.setAttribute(attribute, value.replace(/(Icons\/|manifest-|browserconfig-)(light|dark)/, '$1' + shade));
          });

          return shade;
        }

        window.Requestarr.applyIconTheme = function (theme) {
          chosen = theme || chosen;
          return apply();
        };

        system.addEventListener('change', apply);

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', apply);
        }

        apply();
      })();
    </script>

    <% for (key in htmlWebpackPlugin.files.js) { %><script type="text/javascript" src="<%= htmlWebpackPlugin.files.js[key] %>" data-no-hash></script><% } %>
    <% for (key in htmlWebpackPlugin.files.css) { %><link href="<%= htmlWebpackPlugin.files.css[key] %>" rel="stylesheet"></link><% } %>

    <title>Requestarr</title>

    <!--
      The super basic styling for .root  will live here,
      saves fighting with CSS Modules for ~10 lines
    -->
    <style>
      .root {
        overflow: hidden;
        height: 100%; /* needed for proper layout */
      }

      @media only screen and (max-width: 768px) {
        .root {
          display: flex;
          flex-direction: column;
          min-height: 100%;
          height: auto;
        }
      }
    </style>
  </head>

  <body>
    <div id="portal-root"></div>
    <div id="root" class="root"></div>
  </body>
</html>
