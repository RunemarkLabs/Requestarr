# Template for docker/secrets.env, which is gitignored and must never be committed.
# `docker/dev.sh init` copies this file and replaces every GENERATE placeholder with a
# random value. Values left as placeholders or empty are filled in by hand.

# Requestarr web login and API key (local dev stack only)
REQUESTARR_ADMIN_USERNAME=admin
REQUESTARR_ADMIN_PASSWORD=GENERATE
REQUESTARR_API_KEY=GENERATE

# Dedicated Sonarr and Radarr test instances in the Compose stack
SONARR_TEST_API_KEY=GENERATE
RADARR_TEST_API_KEY=GENERATE

# QA stack (the default): the QA Discord server and its bot application (developer portal)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=
# Optional: role whose members are Requestarr admins (the server owner always is)
DISCORD_ADMIN_ROLE_ID=

# Dev stack (--stack dev, and every live test): a separate Discord server and bot, so automated testing
# never touches the QA server
DEV_DISCORD_BOT_TOKEN=
DEV_DISCORD_APPLICATION_ID=
DEV_DISCORD_GUILD_ID=
DEV_DISCORD_ADMIN_ROLE_ID=

# Bug reports become GitHub issues (a fine-grained token with only "Issues: read and write" on RunemarkLabs/Requestarr).
# QA files for real; dev's issues are labelled "test". The same token can go in both.
GITHUB_ISSUES_TOKEN=
DEV_GITHUB_ISSUES_TOKEN=

# Optional host ports (localhost only). One band per environment, the first digit counting down to the standard port:
# Dev 39797, 38989, 37878. QA 29797, 28989, 27878. (Beta 19797, 18989, 17878; production 9797, 8989, 7878.)
# REQUESTARR_PORT= SONARR_TEST_PORT= RADARR_TEST_PORT=
# DEV_REQUESTARR_PORT= DEV_SONARR_TEST_PORT= DEV_RADARR_TEST_PORT=

# Optional: The Movie Database API Read Access Token, for cast on result lines and cards
TMDB_API_KEY=

# Phase 3: media server token (automated tests always fake invites)
PLEX_TOKEN=
